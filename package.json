{
  "name": "api-security-test-suite",
  "version": "1.0.0",
  "description": "OWASP API Security Top 10 (2023) test suite proven against a deliberately vulnerable and a hardened API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "start:vulnerable": "SECURITY_MODE=vulnerable tsx src/server.ts",
    "start:upstream": "tsx tests/support/upstream-stub.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:api": "playwright test",
    "test:api:vulnerable": "SECURITY_MODE=vulnerable playwright test",
    "assert:hardened": "tsx scripts/assert-detection.ts --mode hardened",
    "assert:vulnerable": "tsx scripts/assert-detection.ts --mode vulnerable"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
